SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
ALLOWED_HOSTS=.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app-name.up.railway.app
TIME_ZONE=America/New_York
APP_VERSION=2.0.0

# Railway provides DATABASE_URL when a PostgreSQL service is linked.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required on first deployment. INITIAL_GUARDIAN_PASSWORD supplies the adult accounts, including Mom's viewer login.
INITIAL_CHILD_PASSWORD=change-this-for-children
INITIAL_GUARDIAN_PASSWORD=change-this-for-guardians
# KJ_PASSWORD=
# ASTORIA_PASSWORD=
# SAPHIRA_PASSWORD=
# DAD_PASSWORD=
# MOM_PASSWORD=
# GG_PASSWORD=

# Required for guardian push notifications and the nightly star reminder.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:parent@example.com

# Optional read-only display of a Teamup calendar intentionally made public.
# Dad can also configure the public Teamup URL from the in-app Settings panel.
TEAMUP_CALENDAR_URL=https://teamup.com/c/ghm7w1

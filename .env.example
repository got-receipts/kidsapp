SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
ALLOWED_HOSTS=.railway.app
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=America/New_York
APP_VERSION=2.2.0

# Railway provides DATABASE_URL when a PostgreSQL service is linked.
DATABASE_URL=postgresql://user:password@host:5432/database

# Standard *.up.railway.app domains are trusted automatically. Set this only for custom public domains.
# CSRF_TRUSTED_ORIGINS=https://family.example.com

# Initial shared family login password requested for this private installation.
# INITIAL_GUARDIAN_PASSWORD supplies the adult accounts, including Mom's viewer login.
INITIAL_CHILD_PASSWORD=password123
INITIAL_GUARDIAN_PASSWORD=password123
# KJ_PASSWORD=
# ASTORIA_PASSWORD=
# SAPHIRA_PASSWORD=
# DAD_PASSWORD=
# MOM_PASSWORD=
# GG_PASSWORD=

# Required for guardian push notifications and the nightly star reminder.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:parent@example.com
